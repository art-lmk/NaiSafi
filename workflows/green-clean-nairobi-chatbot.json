    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst m = d.math;\nconst insights = [];\n\nif (m && m.breakdown && m.breakdown.length > 0) {\n  const top = m.breakdown[0];\n  if (top && top.value > 0) {\n    const unitMap = {\n      trees_planted: 'trees',\n      waste_loads: 'waste loads',\n      loads_remaining: 'loads remaining',\n      trucks: 'trucks allocated',\n      attendees: 'attendees',\n      staff_deployed: 'staff deployed',\n      reports: 'reports',\n      bin_emptying: 'bins emptied',\n      litter_picking: 'litter picking activities',\n      drainage_desilting: 'drainage/desilting activities',\n      street_sweeping: 'street sweeping activities',\n      slashing_raking: 'slashing/raking activities',\n      waste_transfer: 'waste transfers',\n      facility_cleaning: 'facility cleaning activities'\n    };\n    const unit = unitMap[m.metric] || m.metric.replace(/_/g, ' ');\n    insights.push(`${top.group} has the most with ${top.value.toLocaleString()} ${unit}`);\n  }\n}\n\nreturn [{ json: Object.assign({}, d, { insights }) }];"
      },
