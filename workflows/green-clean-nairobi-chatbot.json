    {
      "parameters": {
        "jsCode": "// Ultra-defensive — cannot throw\nlet out = 'No records were found or synthesized for this request.';\n\ntry {\n  let items = [];\n  try { items = $input.all() || []; } catch (e) { items = []; }\n\n  const item = items[0] || null;\n  let d = {};\n  if (item) {\n    try { d = item.json || {}; } catch (e) { d = {}; }\n    if (!d || typeof d !== 'object' || Object.keys(d).length === 0) {\n      d = item;\n    }\n  }\n\n  const looksLikeHtml = (s) => {\n    if (typeof s !== 'string') return false;\n    return s.indexOf('<html') !== -1 ||\n           s.indexOf('Bad Gateway') !== -1 ||\n           s.indexOf('nginx/') !== -1;\n  };\n\n  const tryString = (v) => (typeof v === 'string' && v.trim().length > 0) ? v : null;\n\n  let candidate = null;\n\n  // 1. Normal Anthropic shape\n  if (!candidate && d && d.content && Array.isArray(d.content) && d.content.length > 0) {\n    const first = d.content[0];\n    if (first && typeof first.text === 'string') candidate = first.text;\n  }\n\n  // 2. Flat text shapes\n  if (!candidate) candidate = tryString(d.response);\n  if (!candidate) candidate = tryString(d.text);\n  if (!candidate) candidate = tryString(d.output);\n\n  // 3. Error envelope on .json\n  if (!candidate && d && d.error) {\n    const msg = typeof d.error === 'string' ? d.error\n              : (typeof d.error.message === 'string' ? d.error.message\n              : (typeof d.error.error === 'string' ? d.error.error : ''));\n    candidate = msg || null;\n  }\n\n  // 4. Error on the item root\n  if (!candidate && item && item.error) {\n    const err = item.error;\n    const msg = typeof err === 'string' ? err\n              : (typeof err.message === 'string' ? err.message : '');\n    candidate = msg || null;\n  }\n\n  // Decide final output\n  if (candidate) {\n    out = looksLikeHtml(candidate)\n      ? 'The analytics service is temporarily unreachable. Please try again in a moment.'\n      : candidate;\n  } else {\n    out = 'No records were found or synthesized for this request.';\n  }\n\n  // Cleanup\n  out = out.replace(/\\bspans\\b/gi, 'covers');\n  out = out.replace(/!\\[.*?\\](?:\\(.*?\\))?/g, '').trim();\n\n} catch (err) {\n  // Absolute last resort\n  out = 'The analytics service is temporarily unreachable. Please try again in a moment.';\n}\n\nreturn [{\n  json: {\n    output: out,\n    text: out\n  }\n}];"
