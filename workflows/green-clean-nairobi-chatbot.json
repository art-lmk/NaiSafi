    {
      "parameters": {
        "jsCode": "let rawRowsInput = [];\ntry { rawRowsInput = $input.all() || []; } catch (e) { rawRowsInput = []; }\n\nconst carryData = $('1. Init & Load Memory').first()?.json || {};\nconst parseData = $('4. Parse Intent').first()?.json || {};\n\nconst intent = parseData.intent || {\n  sheet: 'Truck Allocation Vs Waste Loads',\n  metric: 'waste_loads',\n  operation: 'sum',\n  filters: []\n};\nconst targetSheet = intent.sheet || 'Truck Allocation Vs Waste Loads';\n\nconst d = {\n  sessionId: carryData.sessionId || 'default',\n  question: carryData.question || carryData.chatInput || '',\n  config: carryData.config || {},\n  nowISO: carryData.nowISO || new Date().toISOString().slice(0, 10),\n  intent: intent\n};\n\nfunction num(v) {\n  if (v == null) return null;\n  const raw = String(v).trim();\n  if (raw === '') return null;\n  const cleanStr = raw.replace(/,/g, '');\n  const m = cleanStr.match(/-?\\d+(?:\\.\\d+)?/);\n  if (!m) return null;\n  const n = Number(m[0]);\n  return isNaN(n) ? null : n;\n}\n\nconst CLAMP = {\n  staff_deployed: 5000,\n  trees_planted: 100000,\n  attendees: 50000,\n  waste_loads: 50000,\n  loads_remaining: 50000,\n  trucks: 1000,\n  litter_picking: 100000,\n  drainage_desilting: 100000,\n  street_sweeping: 100000,\n  slashing_raking: 100000,\n  waste_transfer: 100000,\n  bin_emptying: 100000,\n  facility_cleaning: 100000\n};\n\nfunction cl(field, v) {\n  if (v == null) return null;\n  const mx = CLAMP[field];\n  if (mx != null && (v < 0 || v > mx)) return null;\n  return v;\n}\n\nfunction goodYear(s) {\n  if (!s) return null;\n  const y = +s.slice(0, 4);\n  return (y >= 2020 && y <= 2035) ? s : null;\n}\n\n// -------------------------------------------------------------\n// KENYAN DD/MM/YYYY DATE PARSER\n// -------------------------------------------------------------\nfunction iso(v) {\n  if (v == null || v === '') return null;\n  if (v instanceof Date) {\n    return isNaN(v.getTime()) ? null : goodYear(v.toISOString().slice(0, 10));\n  }\n  let s = String(v).trim();\n\n  // Excel serial numbers\n  if (/^\\d{5}(?:\\.\\d+)?$/.test(s)) {\n    const serial = Number(s);\n    const dateInfo = new Date(Math.round((serial - 25569) * 86400 * 1000));\n    return isNaN(dateInfo.getTime()) ? null : goodYear(dateInfo.toISOString().slice(0, 10));\n  }\n\n  // Strict Kenyan format: DD/MM/YYYY\n  const ddmmyyyyMatch = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})/);\n  if (ddmmyyyyMatch) {\n    const day = ddmmyyyyMatch[1].padStart(2, '0');\n    const month = ddmmyyyyMatch[2].padStart(2, '0');\n    const year = ddmmyyyyMatch[3];\n    return goodYear(`${year}-${month}-${day}`);\n  }\n\n  if (/^\\d{4}-\\d{2}-\\d{2}/.test(s)) return goodYear(s.slice(0, 10));\n\n  const dt = new Date(s);\n  return isNaN(dt.getTime()) ? null : goodYear(dt.toISOString().slice(0, 10));\n}\n\nconst NAIROBI_SUBCOUNTIES = [\n  'Dagoretti North', 'Dagoretti South', 'Embakasi Central', 'Embakasi East',\n  'Embakasi North', 'Embakasi South', 'Embakasi West', 'Kamukunji',\n  'Kasarani', 'Kibra', \"Lang'ata\", 'Makadara', 'Mathare',\n  'Roysambu', 'Ruaraka', 'Starehe', 'Westlands'\n];\n\nfunction cleanSubcounty(sc) {\n  if (!sc) return '';\n  const raw = String(sc).trim();\n  const norm = raw.replace(/[''\\-_]/g, '').toLowerCase().replace(/\\s+/g, ' ');\n  if (norm === 'kibera') return 'Kibra';\n  if (norm === 'kamkunji') return 'Kamukunji';\n  for (const official of NAIROBI_SUBCOUNTIES) {\n    const offNorm = official.replace(/[''\\-_]/g, '').toLowerCase().replace(/\\s+/g, ' ');\n    if (offNorm === norm || norm.includes(offNorm)) return official;\n  }\n  return raw;\n}\n\nfunction normalizeRow(row, sheetName) {\n  function getValue(keys) {\n    const rowKeys = Object.keys(row || {});\n    for (const key of keys) {\n      const cleanTarget = key.toLowerCase().replace(/[\\s\\-_]+/g, '').trim();\n      for (const rawCol of rowKeys) {\n        const cleanCol = rawCol.toLowerCase().replace(/[\\s\\-_]+/g, '').trim();\n        if (cleanCol === cleanTarget || cleanCol.includes(cleanTarget)) {\n          const val = row[rawCol];\n          if (val !== undefined && val !== null && String(val).trim() !== '') return val;\n        }\n      }\n    }\n    return null;\n  }\n\n  // ACCURATELY DISTINGUISH SUB-ACTIVITY (Trees Planted vs Seedlings Propagated)\n  function getSubActivity(r) {\n    const keys = Object.keys(r || {});\n    for (const k of keys) {\n      const clean = k.toLowerCase().replace(/[\\s\\-_]+/g, '').trim();\n      if (clean === 'selectactivitycategory' || clean === 'activitycategory') {\n        const val = r[k];\n        if (val && String(val).trim()) return String(val).trim();\n      }\n    }\n    for (const k of keys) {\n      const v = String(r[k] || '').trim();\n      if (/trees planted|seedlings propagated|landscaping/i.test(v)) {\n        return v;\n      }\n    }\n    return null;\n  }\n\n  let dateVal = getValue(['Date', 'Enter Date', 'Timestamp', 'Activity Date']);\n  const borough = getValue(['Borough', 'borough']) || '';\n  const subcounty = cleanSubcounty(getValue(['SubCounty', 'Sub County', 'Subcounty']));\n  const rawWard = getValue(['Specific ward', 'Choose your ward', 'Ward', 'ward']) || '';\n  const ward = String(rawWard).replace(/\\bward\\b/gi, '').trim();\n  const location = getValue(['Indicate Road/Location/Street Name', 'Location', 'Street']) || '';\n\n  const responsibleEntity = getValue([\n    'Responsible Entity', 'Who Collects', 'Contractor', 'Service Provider',\n    'Entity', 'Company', 'responsible_entity'\n  ]) || '';\n\n  const vehicleType = getValue([\n    'Vehicle Type', 'Type of Vehicle', 'Truck Type', 'Vehicle Category',\n    'Truck Description', 'Make', 'Model', 'vehicle_type'\n  ]) || '';\n\n  const vehicleRegistration = getValue([\n    'Vehicle Registration', 'Registration Number', 'Number Plate', 'Reg No',\n    'Truck No', 'Vehicle No', 'Plate'\n  ]) || '';\n\n  let staff = num(getValue(['Number of staff deployed', 'Staff Deployed', 'Staff']));\n  let attendees = num(getValue(['Number of attendees', 'Attendees', 'Participants']));\n  let treesPlanted = num(getValue(['Number of trees planted', 'Trees Planted', 'trees_planted']));\n  \n  let trucks = num(getValue([\n    'Number of trucks allocated/assigned', 'Trucks Allocated',\n    'Number of trucks allocated', 'No. of Trucks Allocated',\n    'No of Trucks Allocated', 'No. of Trucks', 'Trucks', 'Allocated Trucks'\n  ]));\n\n  let wasteLoads = num(getValue([\n    'Total Loads Collected', 'Loads Collected', 'Waste Loads Collected', 'Waste Loads', 'waste_loads'\n  ]));\n\n  let loadsRemaining = num(getValue([\n    'Loads Remaining', 'Garbage Backlog', 'loads_remaining', 'Backlog'\n  ]));\n\n  let litterPicking = num(getValue(['Litter Picking']));\n  let drainageDesilting = num(getValue(['Drainage/Desilting', 'Drainage Desilting']));\n  let streetSweeping = num(getValue(['Street Sweeping']));\n  let slashingRaking = num(getValue(['Slashing & Raking']));\n  let wasteTransfer = num(getValue(['Waste Transfer']));\n  let binEmptying = num(getValue(['Bin Emptying', 'Bins Emptied', 'Number of Bins Emptied']));\n  let facilityCleaning = num(getValue(['Facility Cleaning']));\n\n  const specificSubActivity = getSubActivity(row);\n  const activityType = specificSubActivity || getValue(['Select activity category', 'Select activities done', 'Activity Category', 'Activity Type']) || \n    (sheetName.includes('Truck') || sheetName.includes('Allocation') ? 'Truck Allocation & Collection' : (sheetName.includes('Greening') ? 'Tree Planting' : 'General Maintenance'));\n\n  const challenges = getValue(['Challenges faced', 'challenges']) || '';\n  const solutions = getValue(['Suggested solutions', 'solutions']) || '';\n  const resourcesLacking = getValue(['Which resources are lacking', 'Resources', 'resources_lacking']) || '';\n\n  return {\n    borough: String(borough).trim(),\n    subcounty: String(subcounty).trim(),\n    ward: String(ward).trim(),\n    location: String(location).trim(),\n    date: iso(dateVal),\n    activity_type: String(activityType).trim(),\n    challenges: String(challenges).trim(),\n    solutions: String(solutions).trim(),\n    responsible_entity: String(responsibleEntity).trim(),\n    vehicle_type: String(vehicleType).trim(),\n    vehicle_registration: String(vehicleRegistration).trim(),\n    staff_deployed: cl('staff_deployed', staff),\n    attendees: cl('attendees', attendees),\n    trees_planted: cl('trees_planted', treesPlanted),\n    waste_loads: cl('waste_loads', wasteLoads),\n    loads_remaining: cl('loads_remaining', loadsRemaining),\n    trucks: cl('trucks', trucks),\n    litter_picking: cl('litter_picking', litterPicking),\n    drainage_desilting: cl('drainage_desilting', drainageDesilting),\n    street_sweeping: cl('street_sweeping', streetSweeping),\n    slashing_raking: cl('slashing_raking', slashingRaking),\n    waste_transfer: cl('waste_transfer', wasteTransfer),\n    bin_emptying: cl('bin_emptying', binEmptying),\n    facility_cleaning: cl('facility_cleaning', facilityCleaning),\n    resources_lacking: String(resourcesLacking).trim(),\n    sheet: sheetName,\n    _original: row\n  };\n}\n\nfunction getSafeNodeData(nodeNames) {\n  for (const name of nodeNames) {\n    try {\n      const data = $(name).all().map(i => i.json);\n      if (data && data.length > 0) return data;\n    } catch (e) {}\n  }\n  return [];\n}\n\nconst rawRows = rawRowsInput.map(i => i.json).filter(Boolean);\n\nconst truckAllocData = getSafeNodeData([\n  '5b.Truk Allocation Vs Waste Loads',\n  '5b.Truk Allocation Vs Waste  Loads',\n  '5b. Truck Allocation Vs Waste Loads',\n  '5b. Truck allocation Vs Waste Loads'\n]);\nconst envData = getSafeNodeData(['5e.Environ Activities by Ward', '5e. Environment Activities by Ward']);\nconst giData = getSafeNodeData(['5a. Greening Initiatives', '5a. Greening Initiative']);\nconst sensData = getSafeNodeData(['5c. Sensitization Programs ', '5c. Sensitization Programs']);\nconst wasteData = getSafeNodeData(['5d. Wasteload collection', '5d. Waste load collection', '5d.Waste load collection']);\n\nlet selectedData = [];\nlet usedSource = 'none';\n\nconst isTargetGreening = /green|tree|seedling/i.test(targetSheet);\nconst isTargetEnv = /environ/i.test(targetSheet);\nconst isTargetWaste = /waste/i.test(targetSheet);\nconst isTargetTruckAlloc = /truck|allocat|zoomlion/i.test(targetSheet);\nconst isTargetSensitization = /sensitiz/i.test(targetSheet);\n\nif (rawRows.length > 0) {\n  selectedData = rawRows;\n  usedSource = `google sheets (${targetSheet})`;\n} else if (isTargetGreening && giData.length > 0) {\n  selectedData = giData;\n  usedSource = 'google sheets (Greening Initiative)';\n} else if (isTargetTruckAlloc && truckAllocData.length > 0) {\n  selectedData = truckAllocData;\n  usedSource = 'google sheets (Truck Allocation Vs Waste Loads)';\n} else if (isTargetWaste && wasteData.length > 0) {\n  selectedData = wasteData;\n  usedSource = 'google sheets (Waste Collection)';\n} else if (isTargetSensitization && sensData.length > 0) {\n  selectedData = sensData;\n  usedSource = 'google sheets (Sensitization Programs)';\n} else if (isTargetEnv && envData.length > 0) {\n  selectedData = envData;\n  usedSource = 'google sheets (Environ Activities by Ward)';\n}\n\nlet allRows = [];\ntry {\n  allRows = selectedData.map(row => normalizeRow(row, usedSource));\n} catch (e) {\n  allRows = [];\n}\n\nreturn [{\n  json: Object.assign({}, d, {\n    intent,\n    rows: allRows,\n    usedSource,\n    counts: { incoming: allRows.length },\n    detectedSheet: targetSheet\n  })\n}];"
      },
      "id": "e1f3ddee-a54e-4937-8350-ea42bd58c5ee",
      "name": "6. Resolve Data Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "let d = {};\ntry { d = $input.first()?.json || {}; } catch (e) { d = {}; }\nlet intent = d.intent || {};\ntry { intent = intent || $('4. Parse Intent').first()?.json?.intent || {}; } catch (e) {}\n\nlet rows = (d.rows || []).map(r => ({\n  ...r,\n  month: r.date ? r.date.slice(0, 7) : 'Unknown'\n}));\n\nconst today = d.nowISO || $('1. Init & Load Memory').first()?.json?.nowISO || new Date().toISOString().slice(0, 10);\nconst allValidDates = rows.map(r => r.date).filter(Boolean).sort();\nconst validHistoricalDates = allValidDates.filter(dt => dt <= today);\n\nconst minDate = allValidDates.length > 0 ? allValidDates[0] : null;\nconst maxDate = validHistoricalDates.length > 0 ? validHistoricalDates[validHistoricalDates.length - 1] : today;\n\nconst metric = intent.metric || 'reports';\nlet op = intent.operation || 'sum';\nlet groupBy = intent.groupBy || null;\n\nlet filtered = rows;\n\n// 1. DATE BOUNDARY FILTERS (Dynamically filters any month)\nif (intent.dateFrom) filtered = filtered.filter(r => r.date && r.date >= intent.dateFrom);\nif (intent.dateTo) filtered = filtered.filter(r => r.date && r.date <= intent.dateTo);\n\n// 2. ISOLATE ACTUAL 'TREES PLANTED' FROM NURSERY SEEDLINGS (Dynamic for all months)\nif (metric === 'trees_planted') {\n  const directPlanting = filtered.filter(r => \n    r.activity_type && /trees?\\s*planted/i.test(String(r.activity_type).trim())\n  );\n  if (directPlanting.length > 0) {\n    filtered = directPlanting;\n  }\n}\n\n// 3. DYNAMIC FIELD & ENTITY FILTERS\n// 2. DYNAMIC FIELD & ENTITY FILTERS (Fuzzy tolerant for Zoomlion/Contractors)\nfor (const f of (intent.filters || [])) {\n  const fld = String(f.field || '').toLowerCase().trim();\n  const val = String(f.value || '').toLowerCase().trim();\n  if (!val) continue;\n\n  filtered = filtered.filter(r => {\n    // Contractor / Responsible Entity Check\n    const isEntityFilter = ['responsible_entity', 'contractor', 'entity', 'vehicle_type', 'keyword'].includes(fld);\n    if (isEntityFilter) {\n      const cleanVal = val.replace(/zoomlin/g, 'zoomlion').replace(/[\\s\\-_]+/g, '');\n      const cleanEntity = String(r.responsible_entity || '').toLowerCase().replace(/[\\s\\-_]+/g, '');\n      const cleanVehicle = String(r.vehicle_type || '').toLowerCase().replace(/[\\s\\-_]+/g, '');\n      \n      if (cleanEntity.includes(cleanVal) || cleanVehicle.includes(cleanVal)) return true;\n\n      if (r._original && typeof r._original === 'object') {\n        return Object.values(r._original).some(v => \n          String(v || '').toLowerCase().replace(/[\\s\\-_]+/g, '').includes(cleanVal)\n        );\n      }\n      return false;\n    }\n\n    if (r[fld] && String(r[fld]).toLowerCase().includes(val)) return true;\n    return false;\n  });\n}\n\n// 4. METRIC AGGREGATION\nfunction getMetricVal(r, targetMetric, operation) {\n  if (operation === 'count' || targetMetric === 'reports') return 1;\n  const val = r[targetMetric];\n  return (typeof val === 'number' && !isNaN(val)) ? val : 0;\n}\n\nconst total = filtered.reduce((s, r) => s + getMetricVal(r, metric, op), 0);\n\nconst math = { \n  metric: metric,\n  operation: op, \n  groupBy: groupBy, \n  recordCount: filtered.length, \n  datasetMinDate: minDate,\n  datasetMaxDate: maxDate,\n  periodLabel: intent.periodLabel || 'all dates',\n  total: total,\n  breakdown: [],\n  primary: { label: 'Total', value: total }\n};\n\n// 5. GROUPING & BREAKDOWNS\nif (groupBy) {\n  const g = {};\n  for (const r of filtered) {\n    let key = String(r[groupBy] || '').trim() || 'Unspecified';\n    g[key] = (g[key] || 0) + getMetricVal(r, metric, op);\n  }\n  let arr = Object.entries(g).map(([group, value]) => ({ group: group, value: value }));\n  if (groupBy === 'month') {\n    arr.sort((a, b) => a.group.localeCompare(b.group));\n  } else {\n    arr.sort((a, b) => b.value - a.value);\n  }\n  math.breakdown = arr;\n  math.primary = arr.length > 0 ? { label: arr[0].group, value: arr[0].value } : { label: 'Total', value: total };\n}\n\nreturn [{ \n  json: Object.assign({}, d, { \n    intent: intent,\n    math: math, \n    filteredSample: filtered.slice(0, 3) \n  }) \n}];"
      },
