    {
      "parameters": {
        "jsCode": "// Safely extract incoming data from Node 1\nconst item = $input.first();\nconst d = (item && item.json) ? item.json : {};\n\nconst config = d.config || {\n  interpModel: 'claude-haiku-4-5',\n  maxTokensInterp: 400\n};\n\nconst question = d.question || d.chatInput || d.message || d.text || '';\nconst today = d.nowISO || new Date().toISOString().slice(0, 10);\nconst historyText = (d.history || []).map(t => 'User: ' + t.user + '\\nAssistant: ' + t.assistant).join('\\n');\n\nconst CATALOG = [\n  \"NUMERIC METRICS (sum/avg/rank/trend/compare):\",\n  \"  waste_loads (total waste loads collected - Waste Collection or Truck Allocation sheet).\",\n  \"  loads_remaining (backlog / loads remaining).\",\n  \"  trucks (number of trucks allocated/deployed - Truck Allocation Vs Waste Collection sheet).\",\n  \"  staff_deployed (number of staff deployed across environmental maintenance, waste, or greening).\",\n  \"  attendees (number of people attending sensitization or community activities).\",\n  \"  trees_planted (total trees planted - Greening Initiative sheet).\",\n  \"  bin_emptying (number of bins emptied - Environment Activities by Ward).\",\n  \"  litter_picking (Litter Picking - Environment Activities by Ward).\",\n  \"  drainage_desilting (Drainage/Desilting - Environment Activities by Ward).\",\n  \"  street_sweeping (Street Sweeping - Environment Activities by Ward).\",\n  \"  slashing_raking (Slashing & Raking - Environment Activities by Ward).\",\n  \"  waste_transfer (Waste Transfer - Environment Activities by Ward).\",\n  \"  facility_cleaning (Facility Cleaning - Environment Activities by Ward).\",\n  \"  reports = count of activities/records.\",\n  \"\",\n  \"TEXT-FREQUENCY METRICS (operation 'breakdown'):\",\n  \"  activity_type, challenges, solutions, vehicle_type, collection_status, responsible_entity, resources_lacking.\",\n  \"\",\n  \"DIMENSIONS (groupBy / filter / breakdown):\",\n  \"  subcounty, ward, location, date, month, borough, activity_type, vehicle_type, responsible_entity.\",\n  \"\",\n  \"SHEETS AVAILABLE:\",\n  \"  'Greening Initiative'\",\n  \"  'Sensitization Programs'\",\n  \"  'Waste Collection'\",\n  \"  'Truck Allocation Vs Waste Collection'\",\n  \"  'Environment  Activities by ward'\",\n  \"\",\n  \"SHEET SELECTION RULES:\",\n  \"  - If question mentions 'truck allocation', 'trucks allocated', 'allocation vs collection', 'truck vs waste', 'zoomlion', 'contractor', 'truck', 'correlation', 'relationship', 'collected vs backlog', 'backlog vs collection' -> sheet: 'Truck Allocation Vs Waste Collection'\",\n  \"  - If question mentions 'bin', 'bins emptied', 'litter picking', 'drainage', 'desilting', 'sweeping', 'slashing', 'raking', 'facility cleaning' -> sheet: 'Environment  Activities by ward'\",\n  \"  - If question mentions 'waste', 'garbage', 'dumpsite', 'loads remaining' (and not truck allocation) -> sheet: 'Waste Collection'\",\n  \"  - If question mentions 'sensitization', 'public sensitization', 'awareness', 'baraza', 'attendees' -> sheet: 'Sensitization Programs'\",\n  \"  - If question mentions 'tree', 'planting', 'greening', 'seedling' -> sheet: 'Greening Initiative'\",\n  \"  - Otherwise default to 'Environment  Activities by ward' if maintenance/cleanups, else 'Greening Initiative'\"\n].join('\\n');\n\nconst EXAMPLES = [\n  '\"truck allocation vs waste collection in July 2026\" -> {\"type\":\"comparison\",\"operation\":\"compare\",\"metric\":\"waste_loads\",\"dateFrom\":\"2026-07-01\",\"dateTo\":\"2026-07-31\",\"mathRequired\":true,\"sheet\":\"Truck Allocation Vs Waste Collection\"}',\n  '\"records linking Zoomlion to locations\" -> {\"type\":\"lookup\",\"operation\":\"list\",\"metric\":\"reports\",\"filters\":[{\"field\":\"vehicle_type\",\"value\":\"Zoomlion\"}],\"mathRequired\":true,\"sheet\":\"Truck Allocation Vs Waste Collection\"}',\n  '\"how many trucks were allocated in Westlands\" -> {\"type\":\"aggregation\",\"operation\":\"sum\",\"metric\":\"trucks\",\"filters\":[{\"field\":\"subcounty\",\"value\":\"Westlands\"}],\"mathRequired\":true,\"sheet\":\"Truck Allocation Vs Waste Collection\"}',\n  '\"waste loads collected in March 2026\" -> {\"type\":\"aggregation\",\"operation\":\"sum\",\"metric\":\"waste_loads\",\"dateFrom\":\"2026-03-01\",\"dateTo\":\"2026-03-31\",\"mathRequired\":true,\"sheet\":\"Waste Collection\"}',\n  '\"trees planted in July 2026\" -> {\"type\":\"aggregation\",\"operation\":\"sum\",\"metric\":\"trees_planted\",\"dateFrom\":\"2026-07-01\",\"dateTo\":\"2026-07-31\",\"mathRequired\":true,\"sheet\":\"Greening Initiative\"}'\n].join('\\n');\n\nconst system = [\n  \"You are the query-interpretation stage for Nairobi's Green & Clean analytics chatbot.\",\n  \"Map the user's question to ONE sheet ('Environment  Activities by ward', 'Greening Initiative', 'Sensitization Programs', 'Waste Collection', or 'Truck Allocation Vs Waste Collection'), metric, and dimensions.\",\n  \"Output ONLY minified JSON. No markdown fences or commentary.\",\n  \"\",\n  \"CATALOG:\", CATALOG, \"\",\n  \"RULES:\",\n  \"1. For truck allocation, Zoomlion, allocation vs waste collection, or correlation, ALWAYS choose sheet 'Truck Allocation Vs Waste Collection'.\",\n  \"2. For environmental maintenance, bins, litter picking, drainage clearing, sweeping, choose sheet 'Environment  Activities by ward'.\",\n  \"3. For specific months (e.g., 'July 2026'), set dateFrom to 'YYYY-MM-01' and dateTo to the last day of that month.\",\n  \"4. Today is \" + today + \".\",\n  \"\",\n  \"EXAMPLES:\", EXAMPLES\n].join('\\n');\n\nconst userMsg = (historyText ? ('Conversation so far:\\n' + historyText + '\\n\\n') : '') + 'New question: ' + question;\n\nconst interpBodyObj = {\n  model: config.interpModel || 'claude-haiku-4-5',\n  max_tokens: config.maxTokensInterp || 400,\n  temperature: 0,\n  system: system,\n  messages: [{ role: 'user', content: userMsg }]\n};\n\nreturn [{\n  json: Object.assign({}, d, {\n    question: question,\n    interpBody: JSON.stringify(interpBodyObj)\n  })\n}];"
      },
