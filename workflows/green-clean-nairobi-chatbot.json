      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst math = d.math;\nconst question = d.question || '';\n\nlet chartUrl = null;\nlet chartData = null;\n\nfunction generateChartURL(config) {\n    const baseUrl = 'https://quickchart.io/chart';\n    const encoded = encodeURIComponent(JSON.stringify(config));\n    return `${baseUrl}?c=${encoded}`;\n}\n\nfunction detectChartTitle(mathData, question) {\n    const q = question.toLowerCase();\n    let title = 'Green & Clean Nairobi Data';\n    \n    if (mathData.metric) {\n        const metricLabels = {\n            'waste_loads': 'Waste Loads',\n            'loads_remaining': 'Loads Remaining',\n            'trucks': 'Trucks',\n            'staff_deployed': 'Staff Deployed',\n            'attendees': 'Attendees',\n            'trees_planted': 'Trees Planted',\n            'reports': 'Activity Count',\n            'resources_lacking': 'Most Lacking Resources'\n        };\n        const label = metricLabels[mathData.metric] || mathData.metric.replace(/_/g, ' ');\n        title = `${label} by ${mathData.groupBy || 'Category'}`;\n    }\n    \n    if (mathData.period && mathData.period.label && mathData.period.label !== 'all dates') {\n        title += ` (${mathData.period.label})`;\n    }\n    \n    return title;\n}\n\nfunction detectChartType(mathData, question) {\n    const q = question.toLowerCase();\n    \n    if (mathData.ranking && mathData.ranking.length > 0) {\n        return {\n            type: 'bar',\n            title: detectChartTitle(mathData, q),\n            data: mathData.ranking\n        };\n    }\n    \n    if (mathData.breakdown && mathData.breakdown.length > 0) {\n        return {\n            type: 'bar',\n            title: detectChartTitle(mathData, q),\n            data: mathData.breakdown\n        };\n    }\n    \n    if (mathData.trend && mathData.trend.length > 0) {\n        return {\n            type: 'line',\n            title: detectChartTitle(mathData, q),\n            data: mathData.trend\n        };\n    }\n    \n    if (mathData.comparison && mathData.comparison.length > 0) {\n        return {\n            type: 'bar',\n            title: detectChartTitle(mathData, q),\n            data: mathData.comparison\n        };\n    }\n    \n    return null;\n}\n\nfunction buildChartConfig(chartInfo) {\n    if (!chartInfo || !chartInfo.data || chartInfo.data.length === 0) {\n        return null;\n    }\n    \n    const data = chartInfo.data;\n    let labels = [];\n    let values = [];\n    let datasetLabel = '';\n    \n    if (data[0].group !== undefined) {\n        labels = data.map(item => item.group);\n        values = data.map(item => item.value || item.total || 0);\n        datasetLabel = chartInfo.title || 'Value';\n    } else if (data[0].bucket !== undefined) {\n        labels = data.map(item => item.bucket);\n        values = data.map(item => item.total || 0);\n        datasetLabel = chartInfo.title || 'Trend';\n    } else if (data[0].label !== undefined) {\n        labels = data.map(item => item.label);\n        values = data.map(item => item.value || 0);\n        datasetLabel = chartInfo.title || 'Value';\n    } else {\n        labels = Object.keys(data);\n        values = Object.values(data);\n        datasetLabel = chartInfo.title || 'Value';\n    }\n    \n    const colors = [\n        '#3498db', '#e74c3c', '#2ecc71', '#f39c12', \n        '#9b59b6', '#1abc9c', '#e67e22', '#34495e',\n        '#27ae60', '#2980b9', '#8e44ad', '#16a085'\n    ];\n    \n    const backgroundColor = values.map((_, i) => colors[i % colors.length]);\n    \n    const config = {\n        type: chartInfo.type || 'bar',\n        data: {\n            labels: labels,\n            datasets: [{\n                label: datasetLabel,\n                data: values,\n                backgroundColor: backgroundColor,\n                borderColor: colors.map(c => c),\n                borderWidth: 1\n            }]\n        },\n        options: {\n            responsive: true,\n            maintainAspectRatio: true,\n            plugins: {\n                title: {\n                    display: true,\n                    text: chartInfo.title || 'Green & Clean Nairobi Analysis',\n                    font: {\n                        size: 16,\n                        weight: 'bold'\n                    }\n                },\n                legend: {\n                    display: true,\n                    position: 'top'\n                }\n            },\n            scales: {\n                y: {\n                    beginAtZero: true,\n                    ticks: {\n                        callback: function(value) {\n                            if (value >= 1000) {\n                                return value.toLocaleString();\n                            }\n                            return value;\n                        }\n                    }\n                }\n            }\n        }\n    };\n    \n    if (chartInfo.type === 'line') {\n        config.options.elements = {\n            line: {\n                tension: 0.3\n            }\n        };\n        config.data.datasets[0].backgroundColor = 'rgba(52, 152, 219, 0.1)';\n        config.data.datasets[0].borderColor = '#3498db';\n        config.data.datasets[0].pointBackgroundColor = '#3498db';\n        config.data.datasets[0].fill = true;\n        config.data.datasets[0].pointRadius = 4;\n    }\n    \n    if (chartInfo.type === 'pie' || chartInfo.type === 'doughnut') {\n        delete config.options.scales;\n        config.options.plugins.legend.position = 'right';\n    }\n    \n    return config;\n}\n\nlet chartInfo = detectChartType(math, question);\n\nif (chartInfo && chartInfo.data && chartInfo.data.length > 0) {\n    if (chartInfo.data.length > 10) {\n        chartInfo.data = chartInfo.data.slice(0, 10);\n    }\n    \n    const chartConfig = buildChartConfig(chartInfo);\n    \n    if (chartConfig) {\n        chartUrl = generateChartURL(chartConfig);\n        chartData = {\n            config: chartConfig,\n            url: chartUrl,\n            title: chartInfo.title,\n            type: chartInfo.type,\n            dataPoints: chartInfo.data.length\n        };\n    }\n}\n\nreturn [{\n    json: {\n        sessionId: d.sessionId,\n        question: d.question,\n        config: d.config,\n        history: d.history,\n        nowISO: d.nowISO,\n        intent: d.intent,\n        rows: d.rows,\n        usedSource: d.usedSource,\n        counts: d.counts,\n        detectedSheet: d.detectedSheet,\n        math: d.math,\n        filteredSample: d.filteredSample || [],\n        insights: d.insights || [],\n        chartUrl: chartUrl,\n        chartData: chartData,\n        hasChart: chartUrl !== null\n    }\n}];"
      },
