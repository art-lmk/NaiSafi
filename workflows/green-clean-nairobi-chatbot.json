    {
      "parameters": {
        "jsCode": "let resp = {};\nlet carried = {};\ntry { resp = $input.first()?.json || {}; } catch (e) { resp = {}; }\ntry { carried = $('2. Build Interpretation Request').first()?.json || {}; } catch (e) {};\n\nlet text = '';\ntry { \n  text = (resp.content || []).map(b => b.text || '').join(''); \n} catch (e) {}\n\nlet intent = {}; \ntry { \n  const m = text.match(/\\{[\\s\\S]*\\}/); \n  intent = JSON.parse(m ? m[0] : text); \n} catch (e) { \n  intent = { \n    type: 'lookup', \n    operation: 'breakdown', \n    metric: 'waste_loads', \n    filters: [], \n    sheet: 'Truck Allocation Vs Waste Loads'\n  }; \n}\n\nintent.filters = Array.isArray(intent.filters) ? intent.filters.filter(f => f && f.field) : [];\nintent.metric = intent.metric || 'waste_loads';\nintent.operation = intent.operation || 'breakdown';\nintent.limit = intent.limit || 20;\n\n// Read user question safely\nconst rawQ = carried.question || carried.chatInput || carried.message || carried.text || '';\nconst q = String(rawQ).toLowerCase();\n\n// -------------------------------------------------------------\n// INTENT FLAGS\n// -------------------------------------------------------------\nconst isTreeQuery = /tree|plant|seedling|greening/i.test(q);\n\n// RESPONSIBLE ENTITY & CONTRACTOR DETECTION (Includes typo tolerance for Zoomlin)\nconst isEntityQuery = /\\b(contractors?|compan(y|ies)|entities|entity|responsible\\s*entity|service\\s*provider|who\\s*(collected|cleaned|operated|worked|cleared|is\\s*responsible))\\b/i.test(q) ||\n  /zooml[io\\s]+n|syncia|bricks?\\s*master|nccg?|green\\s*army|taka\\s*taka|ziwani|masca|climate\\s*works|century\\s*refuse/i.test(q);\n\nconst isTruckAllocQuery = isEntityQuery || /truck.*allocat|allocat.*truck|truck.*vs.*waste|waste.*vs.*truck|\\ballocation\\b|correlation|relationship|versus|\\bvs\\b|backlog vs|collected vs/i.test(q);\nconst isResourceQuery = /resource|lacking|needed|ppe|tool|equipment|gear/i.test(q);\nconst isWasteQuery = !isTruckAllocQuery && /waste|load|garbage|truck|compactor|tipper|dumpsite/i.test(q);\nconst isStaffQuery = /staff|personnel|workers? deployed|deployment/i.test(q);\nconst isBinsQuery = /bin.*empt|empt.*bin|\\bbins?\\b/i.test(q);\nconst isLitterQuery = /litter\\s*pick/i.test(q);\nconst isDrainageQuery = /drainage|desilt|unclog/i.test(q);\nconst isSweepingQuery = /street\\s*sweep|sweeping/i.test(q);\nconst isSlashingQuery = /slash|rak/i.test(q);\nconst isWasteTransferQuery = /waste\\s*transfer/i.test(q);\nconst isFacilityCleaningQuery = /facility\\s*clean/i.test(q);\nconst isChallengesQuery = /challenge|difficult|obstacle|issue|hindrance/i.test(q);\nconst isEnvQuery = !isTruckAllocQuery && /drainage|unclog|desilt|sweeping|litter|slashing|raking|facility|waste\\s*transfer|bin/i.test(q);\n\nconst wantsMonthlyBreakdown = /\\bby\\s*month\\b|\\bper\\s*month\\b|\\bmonthly\\s*(breakdown|trend|summary|report)\\b/i.test(q);\nconst wantsAreaBreakdown = /\\bby\\s*(subcounty|sub-county|ward|borough)\\b/i.test(q);\n\nconst SINGLE_VALUE_METRICS = new Set([\n  'bin_emptying', 'litter_picking', 'drainage_desilting', 'street_sweeping',\n  'slashing_raking', 'waste_transfer', 'facility_cleaning', 'staff_deployed',\n  'trees_planted', 'attendees', 'waste_loads', 'loads_remaining', 'trucks'\n]);\n\nfunction forceSingleValue(target) {\n  if (SINGLE_VALUE_METRICS.has(target.metric)) {\n    if (!wantsMonthlyBreakdown && !wantsAreaBreakdown && !target.groupBy) {\n      target.groupBy = null;\n      target.operation = 'sum';\n    } else if (wantsMonthlyBreakdown) {\n      target.groupBy = 'month';\n      target.operation = 'sum';\n    }\n  }\n  return target;\n}\n\n// -------------------------------------------------------------\n// ROUTING ORDER (Entity & Truck Allocation prioritized over Clean/Env)\n// -------------------------------------------------------------\nif (isTreeQuery) {\n  intent.sheet = 'Greening Initiative';\n  intent.targetSource = 'greening';\n  intent.metric = 'trees_planted';\n  forceSingleValue(intent);\n} else if (isTruckAllocQuery || isEntityQuery) {\n  // ROUTE ALL CONTRACTORS & RESPONSIBLE ENTITY QUERIES HERE\n  intent.sheet = 'Truck Allocation Vs Waste Loads';\n  intent.targetSource = 'truck_allocation';\n  intent.metric = 'waste_loads';\n  \n  if (/remaining|backlog/i.test(q)) {\n    intent.metric = 'loads_remaining';\n  } else if (/truck/i.test(q) && !/load|waste|clean/i.test(q)) {\n    intent.metric = 'trucks';\n  }\n} else if (isBinsQuery || isEnvQuery) {\n  intent.sheet = 'Environ Activities by ward';\n  intent.targetSource = 'environment';\n  if (isBinsQuery) { intent.metric = 'bin_emptying'; forceSingleValue(intent); }\n  else if (isLitterQuery) { intent.metric = 'litter_picking'; forceSingleValue(intent); }\n  else if (isDrainageQuery) { intent.metric = 'drainage_desilting'; forceSingleValue(intent); }\n  else if (isSweepingQuery) { intent.metric = 'street_sweeping'; forceSingleValue(intent); }\n  else if (isSlashingQuery) { intent.metric = 'slashing_raking'; forceSingleValue(intent); }\n  else if (isWasteTransferQuery) { intent.metric = 'waste_transfer'; forceSingleValue(intent); }\n  else if (isFacilityCleaningQuery) { intent.metric = 'facility_cleaning'; forceSingleValue(intent); }\n  else if (isStaffQuery) { intent.metric = 'staff_deployed'; forceSingleValue(intent); }\n  else if (isChallengesQuery) { intent.metric = 'reports'; intent.operation = 'breakdown'; intent.groupBy = 'challenges'; }\n  else if (isResourceQuery) { intent.metric = 'resources_lacking'; intent.operation = 'breakdown'; intent.groupBy = 'resources_lacking'; }\n  else { intent.metric = 'reports'; intent.groupBy = 'activity_type'; intent.operation = 'breakdown'; }\n} else if (isWasteQuery) {\n  intent.sheet = 'Waste Collection';\n  intent.targetSource = 'waste';\n  intent.metric = /remaining|backlog/i.test(q) ? 'loads_remaining' : 'waste_loads';\n  forceSingleValue(intent);\n} else if (/sensitization|awareness|baraza|attendee/i.test(q)) {\n  intent.sheet = 'Sensitization Programs';\n  intent.targetSource = 'sensitization';\n}\n\n// -------------------------------------------------------------\n// DYNAMIC \"WHICH WARD / PLACE\" GROUPING\n// -------------------------------------------------------------\nconst isPlaceQuery = /\\b(which|what)\\s+(places?|locations?|areas?|wards?|subcounties|sub-counties|streets?)\\b|\\bwhere\\b/i.test(q);\nif (isPlaceQuery) {\n  if (/\\bwards?\\b/i.test(q)) {\n    intent.groupBy = 'ward';\n  } else if (/\\bsubcount/i.test(q)) {\n    intent.groupBy = 'subcounty';\n  } else {\n    intent.groupBy = 'location';\n  }\n  intent.operation = 'breakdown';\n}\n\n// -------------------------------------------------------------\n// EXTRACT & NORMALIZE ENTITY NAME (Fixes \"zoomlin\" -> \"zoomlion\")\n// -------------------------------------------------------------\nlet extractedEntity = null;\nif (/zooml[io\\s]+n/i.test(q)) {\n  extractedEntity = 'zoomlion';\n} else if (/syncia/i.test(q)) {\n  extractedEntity = 'syncia';\n} else if (/bricks?\\s*master/i.test(q)) {\n  extractedEntity = 'bricks master';\n} else if (/green\\s*army|nccg?/i.test(q)) {\n  extractedEntity = 'ncc';\n} else if (/taka/i.test(q)) {\n  extractedEntity = 'taka';\n} else if (/century/i.test(q)) {\n  extractedEntity = 'century refuse';\n}\n\nif (extractedEntity) {\n  intent.filters = intent.filters.filter(f => !['responsible_entity', 'contractor', 'keyword'].includes(f.field));\n  intent.filters.push({ field: 'responsible_entity', value: extractedEntity });\n}\n\n// Exact match for Switch node\nif (/green|tree|seedling/i.test(intent.sheet)) {\n  intent.sheet = 'Greening Initiative';\n} else if (/truck|allocation/i.test(intent.sheet)) {\n  intent.sheet = 'Truck Allocation Vs Waste Loads';\n} else if (/environ/i.test(intent.sheet)) {\n  intent.sheet = 'Environ Activities by ward';\n} else if (/waste/i.test(intent.sheet)) {\n  intent.sheet = 'Waste Collection';\n} else if (/sensitiz/i.test(intent.sheet)) {\n  intent.sheet = 'Sensitization Programs';\n}\n\n// -------------------------------------------------------------\n// DYNAMIC EXTRACTION FOR ANY MONTH (Jan - Dec)\n// -------------------------------------------------------------\nconst monthNames = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];\nconst monthRegex = /\\b(january|february|march|april|may|june|july|august|september|october|november|december)\\b(?:\\s*(\\d{4}))?/i;\nconst monthMatch = q.match(monthRegex);\n\nif (monthMatch && !intent.dateFrom) {\n  const mIdx = monthNames.indexOf(String(monthMatch[1]).toLowerCase());\n  const year = monthMatch[2] ? parseInt(monthMatch[2], 10) : 2026;\n  const mm = String(mIdx + 1).padStart(2, '0');\n  const lastDay = new Date(Date.UTC(year, mIdx + 1, 0)).getUTCDate();\n  intent.dateFrom = `${year}-${mm}-01`;\n  intent.dateTo = `${year}-${mm}-${String(lastDay).padStart(2, '0')}`;\n}\n\nreturn [{\n  json: Object.assign({}, carried, {\n    question: rawQ,\n    intent: intent\n  })\n}];"
      },
      "id": "42cdeff7-0c15-45f2-b958-ec925fb21633",
      "name": "4. Parse Intent",
