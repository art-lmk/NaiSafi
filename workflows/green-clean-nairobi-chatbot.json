    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst today = d.nowISO || $('1. Init & Load Memory').first()?.json?.nowISO || new Date().toISOString().slice(0, 10);\n\nconst ctx = { \n    today: today,\n    question: d.question || $('1. Init & Load Memory').first().json.question || '', \n    intent: d.intent || {}, \n    data_source_used: d.usedSource || 'google sheets', \n    row_counts: d.counts || {}, \n    pre_computed_facts: d.math || {}, \n    insight_flags: d.insights || [], \n    recent_conversation: (d.history || []).slice(-4),\n    chart_url: d.chartUrl || null,\n    has_chart: d.hasChart || false\n};\n\nconst system = [\n    \"You are an objective analytics system for Nairobi's Green & Clean program.\",\n    \"\",\n    \"TONE & OPENING PHRASING:\",\n    \"- Speak purely in the third-person or objective voice.\",\n    \"- Start responses directly by referencing available data using natural phrasing (e.g., 'Data available indicates that...').\",\n    \"- State ONLY the primary figure and the specific timeframe requested. Example format: 'Data available indicates that **630 trees** were planted in **July 2026**.'\",\n    \"- CRITICAL RULE: When answering a query about a specific timeframe (like a single month), DO NOT mention the overall dataset date boundaries (e.g., do not say 'The dataset covers from 25 November 2025 to 4 September 2026'). Keep the response strictly limited to the queried timeframe.\",\n    \"- NEVER use personal pronouns: DO NOT use 'we', 'our', 'us', 'I', or 'my'.\",\n    \"\",\n    \"VOCABULARY & WORDING RULES:\",\n    \"- Translate snake_case terms into clean, professional wording.\",\n    \"\",\n    \"FORMATTING & HIGHLIGHTS:\",\n    \"- Bold key insights, primary numerical metrics, and specific time periods (e.g., **630 trees**, **July 2026**).\",\n    \"- Keep responses to 1 concise, factual sentence whenever possible.\",\n    \"- Do NOT output markdown image tags like ![...](...) or raw chart placeholders.\",\n    \"\",\n    \"NON-NEGOTIABLE DATA RULES:\",\n    \"- Copy numbers exactly from pre_computed_facts.\",\n    \"- IF recordCount is 0 for a date filter, state that 0 records were found for that period.\"\n].join('\\n');\n\nconst synthBody = { \n    model: 'claude-sonnet-4-6',\n    max_tokens: 800, \n    temperature: 0.3, \n    system: system,\n    messages: [{ \n        role: 'user', \n        content: 'CONTEXT (ground truth):\\n' + JSON.stringify(ctx, null, 2) + '\\n\\nWrite the final answer now.' \n    }] \n};\n\nreturn [{\n  json: Object.assign({}, d, {\n    synthBody: JSON.stringify(synthBody) // <-- Must be stringified like Node 2\n  })\n}];"
      },
